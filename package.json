{
  "name": "unimo",
  "version": "0.0.1",
  "main": "dist/main.cjs",
  "type": "module",
  "scripts": {
    "build:main": "esbuild src/main.ts --bundle --platform=node --external:electron --format=cjs --outfile=dist/main.cjs",
    "dev": "npm run build:main && NODE_ENV=development electron .",
    "start": "npm run build:main && NODE_ENV=production electron .",
    "test": "npm run build:main && playwright test",
    "lint": "prettier --check 'src/**/*.{js,ts,json,html}' 'tests/**/*.{js,ts,html}'",
    "format": "prettier --write 'src/**/*.{js,ts,json,html}' 'tests/**/*.{js,ts,html}'",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "1.58.0",
    "electron": "40.0.0",
    "esbuild": "0.27.2",
    "husky": "9.1.7",
    "playwright": "1.58.0",
    "prettier": "3.8.1",
    "tsx": "4.21.0"
  },
  "prettier": {
    "bracketSpacing": true,
    "bracketSameLine": false,
    "singleQuote": true,
    "semi": true,
    "endOfLine": "lf",
    "tabWidth": 2,
    "trailingComma": "all",
    "arrowParens": "avoid",
    "printWidth": 120
  }
}
